<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand-logo">
      <div class="brand-icon">
        <img src="/img/eleventy.svg" alt="Eleventy Logo">
      </div>
      <span>11ty Starter</span>
      <span class="brand-badge">v2.0</span>
    </a>

    {% include "menu.njk" %}

    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Cambiar tema de color">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href="https://github.com/FrankUsqAbant/starter-project-eleventy" target="_blank" rel="noopener noreferrer" class="github-btn" title="Ver repositorio en GitHub">
        <img src="/img/github.svg" alt="GitHub" width="18" height="18">
        <span>Repo</span>
      </a>
    </div>
  </div>
</header>